# Credentials — never commit
.env.local
*.env
.env
client_secret_*.json

# Python
__pycache__/
*.pyc
.pytest_cache/

# Virtual environment — local only, recreate with:
#   py -3.11 -m venv .venv && pip install -e ".[dev]"
# 3.11 matches the Dockerfile (python:3.11-slim), not the global interpreter.
.venv/

# Build artifact left by `pip install -e .`
*.egg-info/

# Excel exports (use Monday API instead)
docs/*.xlsx

# Terraform — provider binaries and local state cache
**/.terraform/
*.tfstate
*.tfstate.backup
*.tfplan

# Firebase CLI — local deploy cache
hosting/.firebase/

# Design assets — stored in Cloudinary, not in git
*.png
*.jpg
*.webp
Music_SFXs/
Music_SFXs.zip
docs/*.pdf
